# Шаблон прод-окружения. Копируется в `.env.prod`, содержимое целиком кладётся
# в GitHub Secret `PROD_ENV`, workflow пишет его на сервере как `<DEPLOY_PATH>/.env`.
# ВНИМАНИЕ: значения с символом $ compose интерполирует. Секрет с $ пишите как $$.
#
# Порты наружу
DB_EXTERNAL_PORT=5432
BACKEND_EXTERNAL_PORT=3000
FRONTEND_EXTERNAL_PORT=3001
NGINX_EXTERNAL_PORT=8080
TZ=UTC
PORT=3000

# Postgres (сервис db из compose; наружу выставляется только на 127.0.0.1)
# ВАЖНО: POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB применяются только к пустому
# volume `wired_wired_db`. Если volume уже инициализирован другими кредами,
# смена DB_PASSWORD/DB_USER здесь не подействует — сначала приведите креды
# в соответствие (ALTER ROLE или удаление пустого volume вручную).
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_NAME=postgres
DB_PASSWORD=change-me
DB_SYNC=1

# Домен и auth: COMMON_DOMAIN — только домен, без схемы и без api.
COMMON_DOMAIN=example.com
SITE_HOST=https://example.com
AUTH_SECRET=change-me
AUTH_COOKIE_NAME=access_token
GOOGLE_AUTH_CLIENT_ID=change-me
GOOGLE_AUTH_CLIENT_SECRET=change-me
GOOGLE_AUTH_CALLBACK=https://api.example.com/auth/google/callback

# Игра
WIRED_GAME_TICKET_SECRET=change-me
WIRED_PACKAGE_READ_SECRET=change-me
WIRED_PACKAGE_READ_TTL_SEC=900
GODOT_ROOM_IDLE_TIMEOUT_MS=300000
GODOT_ROOM_PORT_START=19100
GODOT_ROOM_PORT_END=19199
GODOT_ROOM_WS_MAX_CLIENTS_PER_ROOM=32
GODOT_ROOM_WS_MAX_TOTAL=512

# Хранилище пакетов в git (bare-репозиторий SHA-256 на пакет).
# Выкат: поднять образ с флагом 0, затем вручную выполнить
#   pnpm --filter server packages:git-migrate -- --all
# и только после успешной миграции переключить флаг на 1 и перезапустить
# backend. Откат — вернуть 0: каталоги revisions/<n> остаются на месте до
# явного `packages:git-cleanup`.
WIRED_PACKAGE_GIT_STORAGE=0

# Frontend (вшиваются в бандл при сборке)
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_BACKEND_URL=https://api.example.com
NEXT_PUBLIC_WEBSOCKET_URL=wss://api.example.com
NEXT_PUBLIC_HASHIDS_SALT=change-me
