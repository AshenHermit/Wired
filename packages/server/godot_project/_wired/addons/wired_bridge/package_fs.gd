class_name WiredPackageFs
extends RefCounted

## File operations for downloadable packages inside the editor project.
##
## Every package lives in its own directory under [member packages_root]. A
## replacement never writes into the live directory: [method op_prepare_replace]
## creates a staging directory, the shell copies the new revision there, and
## [method op_replace] swaps it in with two renames. If the editor dies between
## the renames, the previous directory is still there and
## [method restore_previous_if_needed] rolls the swap back on the next call.
##
## Editor metadata (dot directories and `*.uid` files) is generated by the
## editor itself. It is hidden from snapshots and collection, but copied from
## the old tree into the new one so the editor does not lose its cache.
## `*.import` is package content: it is published as a portable import preset
## (see [method normalize_import_text]).
##
## [member root_override] is set by the headless smoke test only; an empty value
## means [constant DEFAULT_ROOT].

const DEFAULT_ROOT := "res://packages"

## Extensions whose text may contain `res://packages/<slug>/` references. Bare
## extensions, as `String.get_extension()` returns them.
const SLUG_REWRITE_EXTENSIONS := ["gd", "tscn", "tres", "import"]

static var root_override: String = ""

static var _slug_regex: RegEx = null


## Root directory that holds one subdirectory per package.
static func packages_root() -> String:
	return root_override if not root_override.is_empty() else DEFAULT_ROOT


## Project path of the live directory of a package.
static func package_dir(package_slug: String) -> String:
	return packages_root().path_join(package_slug)


## Project path of the directory that receives the next revision.
static func staging_dir(package_slug: String) -> String:
	return packages_root().path_join(".%s.staging" % package_slug)


## Project path of the backup kept while a swap is in flight.
static func previous_dir(package_slug: String) -> String:
	return packages_root().path_join(".%s.previous" % package_slug)


## Package folder names are slugs: lowercase latin letters, digits and
## underscores. Numeric slugs (`"7"`) are valid so packages created before
## slugs existed keep their folder name.
static func is_valid_slug(package_slug: String) -> bool:
	# The static initializer does not survive a script hot reload in an open
	# editor, so rebuild the RegEx lazily whenever it is missing.
	if _slug_regex == null:
		_slug_regex = RegEx.create_from_string("^[a-z0-9_]{1,64}$")
	var found := _slug_regex.search(package_slug)
	# PCRE2 lets `$` match before a trailing newline; require the whole string.
	return found != null and found.get_string() == package_slug


## A package file path must stay inside the package directory.
static func is_valid_relative_path(path: String) -> bool:
	if path.is_empty() or path.begins_with("/") or path.contains("\\"):
		return false
	for segment: String in path.split("/"):
		if segment.is_empty() or segment == "." or segment == "..":
			return false
	return true


## Files the editor owns: any path segment starting with a dot and `*.uid`.
static func is_editor_metadata(rel_path: String) -> bool:
	if rel_path.ends_with(".uid"):
		return true
	for segment: String in rel_path.split("/"):
		if segment.begins_with("."):
			return true
	return false


## Turns a Godot importer sidecar into a portable preset. Keeps the importer
## identity from `[remap]` and the whole `[params]` block (including
## `_subresources`); drops `[deps]` and the machine-local `[remap]` keys `path`,
## `path.*`, `metadata` and `valid`, plus `;` comment lines. Line-based and
## idempotent: blank runs collapse and the result ends with exactly one newline.
static func normalize_import_text(text: String) -> String:
	var kept: PackedStringArray = []
	var section := ""
	var skipping_value := false
	var skip_balance := 0
	for raw_line: String in text.split("\n"):
		var line := raw_line.trim_suffix("\r")
		var stripped := line.strip_edges()
		if skipping_value:
			skip_balance += _bracket_delta(line)
			if skip_balance <= 0:
				skipping_value = false
			continue
		if stripped.begins_with(";"):
			continue
		if stripped.begins_with("[") and stripped.ends_with("]"):
			section = stripped.substr(1, stripped.length() - 2).strip_edges()
			if section != "deps":
				kept.append(line)
			continue
		if section == "deps":
			continue
		if section == "remap":
			var key := _import_key(stripped)
			if key == "path" or key.begins_with("path.") or key == "metadata" or key == "valid":
				skip_balance = _bracket_delta(line)
				skipping_value = skip_balance > 0
				continue
		kept.append(line)
	var collapsed: PackedStringArray = []
	for line: String in kept:
		if line.strip_edges().is_empty():
			if collapsed.is_empty() or collapsed[collapsed.size() - 1].strip_edges().is_empty():
				continue
		collapsed.append(line)
	while not collapsed.is_empty() and collapsed[collapsed.size() - 1].strip_edges().is_empty():
		collapsed.remove_at(collapsed.size() - 1)
	if collapsed.is_empty():
		return ""
	return "\n".join(collapsed) + "\n"


## True when a sidecar carries no import preset: `_subresources` is missing, is
## not a dictionary, or is an empty dictionary. A value that does not parse at
## all counts as a preset so an unfamiliar file is never overwritten.
static func import_preset_is_empty(text: String) -> bool:
	var value := _import_option_text(text, "_subresources")
	if value.is_empty():
		return true
	var parsed: Variant = str_to_var(value)
	if parsed == null:
		return false
	return parsed is Dictionary and (parsed as Dictionary).is_empty()


## Package-relative path of the source an importer sidecar belongs to.
static func import_source_rel_path(import_rel_path: String) -> String:
	return import_rel_path.get_basename()


## True when the source of an importer sidecar exists inside the package.
static func import_source_exists(package_slug: String, import_rel_path: String) -> bool:
	var source_rel := import_source_rel_path(import_rel_path)
	if not is_valid_relative_path(source_rel):
		return false
	return FileAccess.file_exists(package_dir(package_slug).path_join(source_rel))


## Package-relative path for an editor path under [method package_dir] or for a
## package-relative path. Returns an empty string for an empty path, an absolute
## filesystem path, the package root itself, or a path that escapes the package.
static func package_relative_path(package_slug: String, raw_path: String) -> String:
	if not is_valid_slug(package_slug):
		return ""
	var path := raw_path.trim_suffix("/")
	if path.is_empty() or path.begins_with("/") or path.contains("\\"):
		return ""
	var prefix := package_dir(package_slug) + "/"
	if path.contains("://"):
		# Any scheme (`res://`, or `user://` for the smoke test root) must name
		# the live package directory, otherwise the path is out of scope.
		if not path.begins_with(prefix):
			return ""
		path = path.substr(prefix.length())
	elif path.contains(":"):
		# Absolute filesystem paths (`C:/...`).
		return ""
	if not is_valid_relative_path(path):
		return ""
	return path


## Undoes a swap that was interrupted between the two renames.
## Returns an empty string on success, or a message when the rename fails.
static func restore_previous_if_needed(package_slug: String) -> String:
	if not is_valid_slug(package_slug):
		return ""
	var previous := previous_dir(package_slug)
	if not DirAccess.dir_exists_absolute(previous):
		return ""
	var root := package_dir(package_slug)
	if DirAccess.dir_exists_absolute(root):
		return ""
	var error := DirAccess.rename_absolute(previous, root)
	if error != OK:
		return "не удалось восстановить пакет %s из previous: %s" % [package_slug, error_string(error)]
	return ""


# --- operations -----------------------------------------------------------


static func op_exists(package_slug: String) -> Dictionary:
	var invalid := _invalid_slug(package_slug)
	if not invalid.is_empty():
		return {"error": invalid}
	var restore_error := restore_previous_if_needed(package_slug)
	if not restore_error.is_empty():
		return {"error": restore_error}
	return {"exists": DirAccess.dir_exists_absolute(package_dir(package_slug))}


static func op_create_dir(package_slug: String) -> Dictionary:
	var invalid := _invalid_slug(package_slug)
	if not invalid.is_empty():
		return {"error": invalid}
	var error := DirAccess.make_dir_recursive_absolute(package_dir(package_slug))
	if error != OK:
		return {
			"error": "не удалось создать каталог пакета %s: %s" % [package_slug, error_string(error)],
		}
	return {}


static func op_snapshot(package_slug: String) -> Dictionary:
	var invalid := _invalid_slug(package_slug)
	if not invalid.is_empty():
		return {"error": invalid}
	var restore_error := restore_previous_if_needed(package_slug)
	if not restore_error.is_empty():
		return {"error": restore_error}
	var files := {}
	var root := package_dir(package_slug)
	if not DirAccess.dir_exists_absolute(root):
		return {"files": files}
	for rel_path: String in _list_files(root):
		if is_editor_metadata(rel_path):
			continue
		if _is_orphan_import(package_slug, rel_path):
			continue
		files[rel_path] = _package_file_sha(root, rel_path)
	return {"files": files}


static func op_collect(package_slug: String) -> Dictionary:
	var invalid := _invalid_slug(package_slug)
	if not invalid.is_empty():
		return {"error": invalid}
	var restore_error := restore_previous_if_needed(package_slug)
	if not restore_error.is_empty():
		return {"error": restore_error}
	var files: Array = []
	var root := package_dir(package_slug)
	if not DirAccess.dir_exists_absolute(root):
		return {"files": files}
	for rel_path: String in _list_files(root):
		if is_editor_metadata(rel_path):
			continue
		if _is_orphan_import(package_slug, rel_path):
			continue
		var contents := _package_file_bytes(root, rel_path)
		files.append(
			{
				"filepath": rel_path,
				"size": contents.size(),
				"sha256": _package_file_sha(root, rel_path),
				"contents_base64": Marshalls.raw_to_base64(contents),
			}
		)
	return {"files": files}


static func op_prepare_replace(package_slug: String) -> Dictionary:
	var invalid := _invalid_slug(package_slug)
	if not invalid.is_empty():
		return {"error": invalid}
	var restore_error := restore_previous_if_needed(package_slug)
	if not restore_error.is_empty():
		return {"error": restore_error}
	var prepare_error := _remove_tree(previous_dir(package_slug))
	if prepare_error != OK:
		return {
			"error": "не удалось удалить previous пакета %s: %s"
			% [package_slug, error_string(prepare_error)],
		}
	prepare_error = _remove_tree(staging_dir(package_slug))
	if prepare_error != OK:
		return {
			"error": "не удалось удалить staging пакета %s: %s"
			% [package_slug, error_string(prepare_error)],
		}
	var staging := staging_dir(package_slug)
	var error := DirAccess.make_dir_recursive_absolute(staging)
	if error != OK:
		return {"error": "не удалось создать staging пакета %s: %s" % [package_slug, error_string(error)]}
	return {"staging_path": ProjectSettings.globalize_path(staging)}


static func op_replace(package_slug: String) -> Dictionary:
	var invalid := _invalid_slug(package_slug)
	if not invalid.is_empty():
		return {"error": invalid}
	var restore_error := restore_previous_if_needed(package_slug)
	if not restore_error.is_empty():
		return {"error": restore_error}

	var root := package_dir(package_slug)
	var staging := staging_dir(package_slug)
	var previous := previous_dir(package_slug)
	if not DirAccess.dir_exists_absolute(staging):
		return {"error": "staging не найден"}

	var staging_files := _list_files(staging)
	var staged := {}
	# Orphan sidecars are not package content: they never show up in the report.
	var staging_orphans := {}
	for rel_path: String in staging_files:
		staged[rel_path] = true
		if _is_orphan_import_file(staging, rel_path):
			staging_orphans[rel_path] = true
	var had_root := DirAccess.dir_exists_absolute(root)
	var old_files: Array[String] = []
	var old_orphans := {}
	if had_root:
		old_files = _list_files(root)
		for rel_path: String in old_files:
			if _is_orphan_import_file(root, rel_path):
				old_orphans[rel_path] = true

	# Keep the editor's own files: they are not part of the revision.
	if had_root:
		var copy_error := _copy_editor_metadata(root, staging, old_files, staged)
		if not copy_error.is_empty():
			return {"error": copy_error}

	if had_root:
		var backup_error := DirAccess.rename_absolute(root, previous)
		if backup_error != OK:
			return {
				"error": "не удалось освободить каталог пакета %s: %s"
				% [package_slug, error_string(backup_error)],
			}
		var swap_error := DirAccess.rename_absolute(staging, root)
		if swap_error != OK:
			DirAccess.rename_absolute(previous, root)
			_remove_tree(staging)
			return {
				"error": "не удалось переключить staging пакета %s: %s"
				% [package_slug, error_string(swap_error)],
			}
		var cleanup_error := _remove_tree(previous)
		if cleanup_error != OK:
			push_error(
				"не удалось удалить previous пакета %s: %s"
				% [package_slug, error_string(cleanup_error)]
			)
	else:
		var swap_error := DirAccess.rename_absolute(staging, root)
		if swap_error != OK:
			return {
				"error": "не удалось переключить staging пакета %s: %s"
				% [package_slug, error_string(swap_error)],
			}

	var written: Array[String] = []
	for rel_path: String in staging_files:
		if is_editor_metadata(rel_path) or staging_orphans.has(rel_path):
			continue
		written.append(rel_path)
	var deleted: Array[String] = []
	for rel_path: String in old_files:
		if is_editor_metadata(rel_path) or staged.has(rel_path) or old_orphans.has(rel_path):
			continue
		deleted.append(rel_path)
	return {"written": written, "deleted": deleted}


static func op_delete(package_slug: String) -> Dictionary:
	var invalid := _invalid_slug(package_slug)
	if not invalid.is_empty():
		return {"error": invalid}
	var restore_error := restore_previous_if_needed(package_slug)
	if not restore_error.is_empty():
		return {"error": restore_error}
	for path: String in [package_dir(package_slug), staging_dir(package_slug), previous_dir(package_slug)]:
		var error := _remove_tree(path)
		if error != OK:
			return {"error": "не удалось удалить %s: %s" % [path, error_string(error)]}
	return {}


## Deletes selected files or directories inside the live package. Every path is
## either an editor path under [method package_dir] or package-relative. Missing
## paths are ignored. Editor metadata next to a selected file is left alone;
## metadata inside a selected directory is removed with that directory.
static func op_delete_files(package_slug: String, paths: Array) -> Dictionary:
	var invalid := _invalid_slug(package_slug)
	if not invalid.is_empty():
		return {"error": invalid}
	if paths.is_empty():
		return {"error": "не выбран ни один файл пакета"}
	var restore_error := restore_previous_if_needed(package_slug)
	if not restore_error.is_empty():
		return {"error": restore_error}

	var root := package_dir(package_slug)
	# Validate every path before touching the tree so a bad entry cannot leave a
	# half-applied selection behind.
	var rel_paths: Array[String] = []
	for raw_path: Variant in paths:
		if not raw_path is String:
			return {"error": "некорректный путь: %s" % str(raw_path)}
		var raw := str(raw_path)
		if raw.trim_suffix("/") == root:
			return {
				"error": "нельзя удалить корень пакета %s: используйте операцию delete" % package_slug,
			}
		var rel_path := package_relative_path(package_slug, raw)
		if rel_path.is_empty():
			return {"error": "путь вне пакета %s: %s" % [package_slug, raw]}
		rel_paths.append(rel_path)

	var deleted: Array[String] = []
	for rel_path: String in rel_paths:
		var abs_path := root.path_join(rel_path)
		if not DirAccess.dir_exists_absolute(abs_path) and not FileAccess.file_exists(abs_path):
			continue
		var error := _remove_tree(abs_path)
		if error != OK:
			return {"error": "не удалось удалить %s: %s" % [abs_path, error_string(error)]}
		var editor_path := root.path_join(rel_path)
		if not deleted.has(editor_path):
			deleted.append(editor_path)
	return {"deleted": deleted}


## Moves a package directory to a new slug and rewrites the slug in its text
## files. [method op_collect] and [method op_replace] cannot do this: they drop
## `*.uid`/`*.import`, so the editor would lose its metadata and regenerate uids.
## The move is a single rename, so the package keeps its files and metadata.
## Rewritten files are package-relative paths.
static func op_rename(package_slug: String, new_slug: String) -> Dictionary:
	var invalid := _invalid_slug(package_slug)
	if invalid.is_empty():
		invalid = _invalid_slug(new_slug)
	if not invalid.is_empty():
		return {"error": invalid}
	if package_slug == new_slug:
		return {"rewritten": []}
	var old_dir := package_dir(package_slug)
	var new_dir := package_dir(new_slug)
	if not DirAccess.dir_exists_absolute(old_dir):
		return {"error": "slug_source_missing"}
	if DirAccess.dir_exists_absolute(new_dir):
		# A folder left behind by an earlier delete is reused, but a folder with
		# files is another package: moving onto it would destroy both.
		if not _list_files(new_dir).is_empty():
			return {"error": "slug_target_not_empty"}
		var remove_error := _remove_tree(new_dir)
		if remove_error != OK:
			return {
				"error": "не удалось удалить пустой каталог %s: %s" % [new_slug, error_string(remove_error)],
			}
	var rename_error := DirAccess.rename_absolute(old_dir, new_dir)
	if rename_error != OK:
		return {
			"error": "не удалось переименовать пакет %s: %s" % [package_slug, error_string(rename_error)],
		}

	var rewritten: Array[String] = []
	var from_prefix := "res://packages/%s/" % package_slug
	var to_prefix := "res://packages/%s/" % new_slug
	for rel_path: String in _list_files(new_dir):
		if not SLUG_REWRITE_EXTENSIONS.has(rel_path.get_extension()):
			continue
		var abs_path := new_dir.path_join(rel_path)
		var text := FileAccess.get_file_as_string(abs_path)
		if not text.contains(from_prefix):
			continue
		var file := FileAccess.open(abs_path, FileAccess.WRITE)
		if file == null:
			return {
				"error": "не удалось записать %s: %s" % [abs_path, error_string(FileAccess.get_open_error())],
			}
		file.store_string(text.replace(from_prefix, to_prefix))
		file.close()
		rewritten.append(rel_path)
	return {"rewritten": rewritten}


# --- helpers --------------------------------------------------------------


static func _invalid_slug(package_slug: String) -> String:
	if is_valid_slug(package_slug):
		return ""
	return "invalid_slug"


## Relative paths of every file below [param dir_path], recursively.
static func _list_files(dir_path: String) -> Array[String]:
	var files: Array[String] = []
	_collect_files(dir_path, "", files)
	return files


static func _collect_files(abs_dir: String, rel_dir: String, files: Array[String]) -> void:
	var dir := DirAccess.open(abs_dir)
	if dir == null:
		return
	# Dot-prefixed editor metadata must be listed here and dropped deliberately
	# by is_editor_metadata(), never by the OS hiding it from the listing.
	dir.include_hidden = true
	dir.list_dir_begin()
	var name := dir.get_next()
	while not name.is_empty():
		if name == "." or name == "..":
			name = dir.get_next()
			continue
		var rel_path := name if rel_dir.is_empty() else rel_dir.path_join(name)
		var child := abs_dir.path_join(name)
		if dir.current_is_dir():
			_collect_files(child, rel_path, files)
		else:
			files.append(rel_path)
		name = dir.get_next()
	dir.list_dir_end()


## Copies the editor's files from the old tree into staging unless staging
## already has them. [param staged] tracks the files staging already contains.
static func _copy_editor_metadata(
	root: String, staging: String, old_files: Array[String], staged: Dictionary
) -> String:
	for rel_path: String in old_files:
		if not is_editor_metadata(rel_path) or staged.has(rel_path):
			continue
		var target := staging.path_join(rel_path)
		var make_error := DirAccess.make_dir_recursive_absolute(target.get_base_dir())
		if make_error != OK:
			return "не удалось подготовить %s: %s" % [target, error_string(make_error)]
		var contents := FileAccess.get_file_as_bytes(root.path_join(rel_path))
		var file := FileAccess.open(target, FileAccess.WRITE)
		if file == null:
			return "не удалось записать %s: %s" % [target, error_string(FileAccess.get_open_error())]
		file.store_buffer(contents)
		file.close()
		staged[rel_path] = true
	return ""


## Key part of a `key=value` line inside an importer sidecar.
static func _import_key(line: String) -> String:
	var separator := line.find("=")
	if separator < 0:
		return line
	return line.substr(0, separator).strip_edges()


## Net bracket nesting change of a line, ignoring brackets inside quoted text.
static func _bracket_delta(line: String) -> int:
	var delta := 0
	var in_string := false
	var escaped := false
	for character: String in line.split(""):
		if in_string:
			if escaped:
				escaped = false
			elif character == "\\":
				escaped = true
			elif character == "\"":
				in_string = false
			continue
		if character == "\"":
			in_string = true
		elif character == "{" or character == "[":
			delta += 1
		elif character == "}" or character == "]":
			delta -= 1
	return delta


## Raw text of an importer option inside `[params]`, including continuation
## lines of a multi-line dictionary value. Empty when the option is absent.
static func _import_option_text(text: String, option: String) -> String:
	var section := ""
	var collecting := false
	var value := ""
	var balance := 0
	for raw_line: String in text.split("\n"):
		var line := raw_line.trim_suffix("\r").strip_edges()
		if collecting:
			value += "\n" + line
			balance += _bracket_delta(line)
			if balance <= 0:
				return value
			continue
		if line.begins_with("[") and line.ends_with("]"):
			section = line.substr(1, line.length() - 2).strip_edges()
			continue
		if section != "params" or _import_key(line) != option:
			continue
		var separator := line.find("=")
		if separator < 0:
			continue
		value = line.substr(separator + 1).strip_edges()
		balance = _bracket_delta(value)
		if balance <= 0:
			return value
		collecting = true
	return ""


## Bytes of a package file as published: importer sidecars are normalized first,
## everything else is read verbatim.
static func _package_file_bytes(root: String, rel_path: String) -> PackedByteArray:
	var abs_path := root.path_join(rel_path)
	if rel_path.ends_with(".import"):
		return normalize_import_text(_read_text(abs_path)).to_utf8_buffer()
	return FileAccess.get_file_as_bytes(abs_path)


## SHA-256 of a package file as published, matching [method _package_file_bytes].
static func _package_file_sha(root: String, rel_path: String) -> String:
	if rel_path.ends_with(".import"):
		return normalize_import_text(_read_text(root.path_join(rel_path))).sha256_text()
	return FileAccess.get_sha256(root.path_join(rel_path))


static func _read_text(abs_path: String) -> String:
	return FileAccess.get_file_as_string(abs_path)


## A sidecar whose source is gone is never published nor cached.
static func _is_orphan_import(package_slug: String, rel_path: String) -> bool:
	return _is_orphan_import_file(package_dir(package_slug), rel_path)


static func _is_orphan_import_file(root: String, rel_path: String) -> bool:
	if not rel_path.ends_with(".import"):
		return false
	return not FileAccess.file_exists(root.path_join(import_source_rel_path(rel_path)))


## Recursively removes a file or directory; a missing path is not an error.
static func _remove_tree(path: String) -> Error:
	if not DirAccess.dir_exists_absolute(path):
		if FileAccess.file_exists(path):
			return DirAccess.remove_absolute(path)
		return OK
	var dir := DirAccess.open(path)
	if dir == null:
		return DirAccess.get_open_error()
	# Metadata directories are dot-prefixed: list them here so the tree can be
	# removed completely instead of leaving `.previous` behind forever.
	dir.include_hidden = true
	# Collect names first: deleting while enumerating can skip entries.
	var names := PackedStringArray()
	dir.list_dir_begin()
	var name := dir.get_next()
	while not name.is_empty():
		if name != "." and name != "..":
			names.append(name)
		name = dir.get_next()
	dir.list_dir_end()
	for child_name: String in names:
		var error := _remove_tree(path.path_join(child_name))
		if error != OK:
			return error
	return DirAccess.remove_absolute(path)
