{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": [
      "es6",
      "dom",
      "dom.iterable",
      "scripthost"
    ],
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
  },
  "include": [
    "src/**/*",
    "../client/src/networking/ServerAPI.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "paths": {
    "@box2d": [
      "../box2d/src"
    ]
  }
}