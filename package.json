{
  "name": "scriptio2",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server start:dev",
    "build:server": "pnpm --filter server build",
    "start:server": "pnpm --filter server start:prod",
    "dev:playground": "pnpm --filter playground dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build:frontend": "pnpm --filter frontend build",
    "start:frontend": "pnpm --filter frontend start",
    "check-types:frontend": "pnpm --filter frontend check-types",
    "build:shared": "pnpm --filter shared build:types",
    "build": "pnpm run --recursive build",
    "clean": "pnpm run --recursive clean"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "typescript": "^5.9.3"
  }
}