{
  "name": "wired",
  "version": "0.5.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "pnpm --filter server start:dev",
    "build:server": "pnpm --filter server build",
    "start:server": "pnpm --filter server start:prod",
    "dev:frontend": "pnpm --filter frontend dev",
    "build:frontend": "pnpm --filter frontend build",
    "prebuild:frontend": "pnpm --filter frontend prebuild",
    "start:frontend": "pnpm --filter frontend start",
    "check-types:frontend": "pnpm --filter frontend check-types",
    "build:shared": "pnpm --filter shared build",
    "export:game": "pnpm --filter server export:game",
    "fetch:editor": "pnpm --filter server fetch:editor",
    "fetch:runtime": "pnpm --filter server fetch:runtime",
    "fetch:templates": "pnpm --filter server fetch:templates",
    "build": "pnpm run --recursive build",
    "clean": "pnpm run --recursive clean"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "typescript": "^5.9.3"
  }
}